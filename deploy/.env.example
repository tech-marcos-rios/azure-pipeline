# Crear como deploy/.env en el server para el primer deploy manual (nunca
# commitear el real). Estos valores los usa docker-compose.yml (interpolación
# ${VAR}) — son las mismas passwords que ya tiene cada proyecto en su propio
# deploy/.env (DB_PASSWORD de 02-inventory-api, 04-kanban-saas,
# DB_PASSWORD/DB_USER de 05-ai-docs-analyzer).
#
# A partir del primer deploy, .github/workflows/deploy.yml las sincroniza acá
# en cada push a master desde los secrets de GitHub del mismo nombre — si
# alguno de los 3 proyectos rota su password, actualizar el secret acá
# (repo de este proyecto en GitHub), no este archivo a mano en el server.
MINISTOCK_DB_PASSWORD=
KANBAN_DB_PASSWORD=
AI_DOCS_DB_PASSWORD=
